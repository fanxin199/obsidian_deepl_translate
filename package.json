{
  "name": "deepl-translate-selection",
  "version": "1.3.0",
  "description": "Obsidian plugin for translating selected text with DeepL.",
  "main": "main.js",
  "scripts": {
    "build": "node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "test": "npm run build && node --test tests/*.test.cjs",
    "typecheck": "tsc --noEmit",
    "test:mobile": "npm run build && node tests/mobile-reading-smoke.cjs"
  },
  "keywords": [
    "obsidian",
    "deepl",
    "translation",
    "plugin"
  ],
  "author": "Yunfeng",
  "license": "MIT",
  "devDependencies": {
    "@codemirror/view": "6.38.6",
    "@types/node": "^24.6.2",
    "esbuild": "^0.27.4",
    "jsdom": "26.1.0",
    "obsidian": "^1.12.3",
    "playwright-core": "1.62.1",
    "typescript": "^5.9.3"
  }
}
